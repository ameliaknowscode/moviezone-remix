# Local dev environment template — copy to .env and adjust as needed.
# .env itself is gitignored. .env.example IS committed.

# Database — shared Docker container `moviezone-pg` running Postgres 17.
# Started with --restart unless-stopped, so it auto-starts with Docker Desktop.
# Both moviezone-remix and moviezone-django use this same container, separate databases.
DATABASE_URL=postgresql://moviezone:test1234@localhost:5432/moviezone_remix

# Auth (Better Auth — wire up when auth lands)
# BETTER_AUTH_SECRET=  # generate with: openssl rand -base64 32
# BETTER_AUTH_URL=http://localhost:3000

# Email (Resend — wire up when notifications land)
# RESEND_API_KEY=
